# ladder beat chart: one row per rung, designer data (GP40, Rogers ch4).
# Designers pace the climb here without a Rust edit; tools/beat-lint.mjs
# checks every row. Whole numbers only, `#` comments, no floats. Glory is
# counts (no suffix, like loop.rows); minutes are whole minutes per bout.
# Columns: tier (enemy tier 1..3 from enemies.rows; T4 primus stays PROPOSED
# per enemies.rows:18, so tier_3 holds the last rung), new_moves new_rules
# new_arena (new elements this rung: a move, a rule, an arena variant; the
# sum is at most 3), reward (glory for a won bout: 100 + 25 per rung held,
# the ladder.rs math, so this file is a second door to the same numbers),
# penalty (glory lost on a lost bout: flat 25, the slow negative leg, N25),
# minutes (expected bout minutes; rung_0 is 1, so the first bout starts
# within 60 s of launch), rank (glory rank after winning this rung from
# fresh under ladder.rs floors 0/300/900/1800/3600, loop bonus 500 lands
# on the last rung), boss (1 only on the last rung).
# Beat map: rung_0 light + parry (Holder grunt), rung_1 heavy + centre,
# rung_2 dodge answer + stamina (Flanker veteran), rung_3 riposte + ring,
# rung_4 stamina pressure + wall band, rung_5 elite pressure, rung_6 gate
# mouth, rung_7 final bout (boss flag; GA15 primus replaces the tier).
table ladder version 1
rung_0 tier=1 new_moves=1 new_rules=1 new_arena=0 reward=100 penalty=25 minutes=1 rank=0 boss=0
rung_1 tier=1 new_moves=1 new_rules=0 new_arena=1 reward=125 penalty=25 minutes=1 rank=0 boss=0
rung_2 tier=2 new_moves=1 new_rules=1 new_arena=0 reward=150 penalty=25 minutes=2 rank=1 boss=0
rung_3 tier=2 new_moves=1 new_rules=1 new_arena=1 reward=175 penalty=25 minutes=2 rank=1 boss=0
rung_4 tier=2 new_moves=0 new_rules=1 new_arena=1 reward=200 penalty=25 minutes=2 rank=1 boss=0
rung_5 tier=3 new_moves=1 new_rules=1 new_arena=0 reward=225 penalty=25 minutes=3 rank=2 boss=0
rung_6 tier=3 new_moves=1 new_rules=0 new_arena=1 reward=250 penalty=25 minutes=3 rank=2 boss=0
rung_7 tier=3 new_moves=1 new_rules=1 new_arena=1 reward=275 penalty=25 minutes=4 rank=3 boss=1
